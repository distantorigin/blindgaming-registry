{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blindgaming.net/schemas/v1/creator.schema.json",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "$ref": "https://blindgaming.net/schemas/v1/common.schema.json#/$defs/registryId"
    },
    "name": {
      "$ref": "https://blindgaming.net/schemas/v1/common.schema.json#/$defs/displayText"
    },
    "aliases": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "https://blindgaming.net/schemas/v1/common.schema.json#/$defs/displayText"
      }
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "properties": {
          "platform": {
            "type": "string",
            "enum": [
              "youtube",
              "twitch",
              "audiopub",
              "website"
            ]
          },
          "url": {
            "$ref": "https://blindgaming.net/schemas/v1/common.schema.json#/$defs/httpsUrl"
          },
          "name": {
            "$ref": "https://blindgaming.net/schemas/v1/common.schema.json#/$defs/displayText"
          }
        },
        "required": [
          "platform",
          "url"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "name",
    "profiles"
  ],
  "additionalProperties": false
}
